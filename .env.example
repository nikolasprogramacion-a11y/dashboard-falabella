# ==============================================================================
# VARIABLES DE ENTORNO · DASHBOARD FINART S.A.S. (FALABELLA)
# Copia este archivo como '.env' en la raíz y configura tus valores locales.
# NUNCA subas el archivo '.env' real a ningún repositorio de control de versiones.
# ==============================================================================

# 1. Base de datos y almacenamiento de archivos
DB_PATH=ventas.db
DATOS_DIR=datos

# 2. Credenciales API Falabella Seller Center (para sync.py)
FALABELLA_USER_ID=tu_usuario_sellercenter@finartsa.com
FALABELLA_API_KEY=tu_api_key_secreta_aqui
# FALABELLA_BASE_URL=https://sellercenter-api.falabella.com/

# 3. Reglas de negocio y exclusiones
# Pedidos en estos estados no se contabilizan como ventas, pero se miden aparte
ESTADOS_EXCLUIDOS=canceled,cancelled,failed,returned

# Tasa de cambio USD -> COP de respaldo (en caso de indisponibilidad temporal de APIs)
FX_USD_COP=3900.0

# 4. Seguridad y autenticación de usuarios
# Opción A: Contraseña global única
DASHBOARD_PASSWORD=cambia_esta_clave_segura_2026

# Opción B: Múltiples usuarios y contraseñas (separados por comas, usuario:clave)
# DASHBOARD_USERS=gerente:claveGerente2026,operaciones:claveOps2026

# 5. Enchufes para datos futuros opcionales
# Comisión negociada real con Falabella Seller Center (ejemplo: 0.15 para 15%)
# COMISION_REAL_NEGOCIADA=0.15
